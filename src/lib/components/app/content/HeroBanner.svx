<script lang="ts">
	import InstallCommand from './InstallCommand.svelte';
	import Logo from '$lib/components/app/misc/Logo.svelte';

	const iconSvg = $derived(
		mode.current === 'dark'
			? iconDarkSvg
			: typeof window === 'undefined'
				? iconLightSvg
				: window.matchMedia('(prefers-color-scheme: dark)').matches
					? iconDarkSvg
					: iconLightSvg
	);
</script>

<section class="flex flex-col items-center gap-16 py-16 text-balance">
	<Logo  showName/>

	<div class="flex flex-col items-center gap-6 text-center">

        # AI that lives on your computer. Open-source, private &amp; always local.

		Run frontier AI entirely on your machine. No API keys, no telemetry, no limits. Own your
		models and conversation data.
	</div>

	<InstallCommand />
</section>

