engine-strict=true

; Pin the canonical registry so package-lock.json stays portable regardless of
; any registry configured at the user level.
registry=https://registry.npmjs.org

; Supply-chain hygiene: only install versions published at least 3 days ago.
min-release-age=3

; Supply-chain hygiene: never run install scripts from dependencies. Also
; skips our own `prepare` script, which is fine -- the SvelteKit Vite plugin
; runs `svelte-kit sync` itself during dev/build.
ignore-scripts=true
